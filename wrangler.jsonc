{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alpha",
  "main": "./alpha-core.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alpha-stage6-test",
      "database_id": "affb19ba-4d34-49ea-b0ee-3cec68766534"
    }
  ]
}
