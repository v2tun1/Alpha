{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alpha",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alpha",
      "database_id": "2ac3df84-d2aa-407f-8286-a6826d0a8692"
    }
  ]
}
