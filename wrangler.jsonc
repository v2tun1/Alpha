{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alpha",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alpha",
      "database_id": "4dcb4627-b2a7-48d8-9f4e-fb1ee8bc4e4d"
    }
  ]
}
