{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alpha",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alpha",
      "database_id": "d7fd9e69-12df-4e8b-a815-4d2d2334d6eb"
    }
  ]
}
