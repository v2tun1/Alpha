{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alpha",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alpha",
      "database_id": "0c0908fe-9c4c-4f3f-b17b-9c7fb7119d97"
    }
  ]
}
